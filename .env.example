# =========================================================================
# Franchise HUB — variáveis de ambiente (template)
# Copie para .env e preencha. NUNCA commite .env real.
# =========================================================================

# Postgres (Neon ou local). Para Neon, manter ?pgbouncer=true&connect_timeout=15
# Local: postgresql://USER:PASS@localhost:5432/franchise_hub?schema=public
DATABASE_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# URL direta (sem pooler) — usada por migrations no Neon. Em Postgres local,
# pode repetir o valor de DATABASE_URL sem o ?pgbouncer.
DIRECT_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require"

# Ambiente
NODE_ENV="development"

# NextAuth / Auth.js (Fase 2) — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Chave de criptografia para tokens OAuth em repouso (Fase 5) — 32 bytes em base64
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# OAuth — Google Ads (Fase 5)
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# OAuth — Meta Ads (Fase 5)
META_ADS_CLIENT_ID=""
META_ADS_CLIENT_SECRET=""

# Modo mock das integrações (desenvolvimento sem APIs reais)
ADS_INTEGRATIONS_MODE="mock"

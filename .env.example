# =========================================================================
# Franchise HUB — variáveis de ambiente (template)
# Copie para .env e preencha. NUNCA commite .env real.
# =========================================================================

# -------------------------------------------------------------------------
# Postgres
# -------------------------------------------------------------------------
# Neon (dev): manter ?pgbouncer=true&connect_timeout=15
# Postgres local (incl. compose self-host): sem pgbouncer
#   postgresql://USER:PASS@HOST:5432/franchise_hub?schema=public
DATABASE_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# URL direta (sem pooler) — usada pelo Prisma Migrate e pelo setup-app-role.
# No Postgres self-hosted, pode repetir DATABASE_URL sem o ?pgbouncer.
DIRECT_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require"

# -------------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------------
NODE_ENV="development"

# Porta e host do server.js do Next (output standalone). Em prod, o compose
# fixa em 0.0.0.0:3000 dentro do container, e mapeia 127.0.0.1:3000 no host
# para nginx fazer o proxy_pass.
PORT="3000"
HOSTNAME="0.0.0.0"

# -------------------------------------------------------------------------
# Auth.js v5 (Fase 2)
# -------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
# Aceita AUTH_SECRET ou NEXTAUTH_SECRET — os dois funcionam.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Em produção atrás de proxy/CDN (nginx, Cloudflare, ALB): "true".
# Em dev local pode ficar vazio.
AUTH_TRUST_HOST=""

# -------------------------------------------------------------------------
# Criptografia & secrets
# -------------------------------------------------------------------------
# Chave para criptografar tokens OAuth em repouso (Fase 5) — 32 bytes base64.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# Secret para autorizar /api/cron/sync e /api/cron/retention.
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# -------------------------------------------------------------------------
# Integrações de Ads (Fase 5)
# -------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

META_ADS_CLIENT_ID=""
META_ADS_CLIENT_SECRET=""

# Modo das integrações: "mock" (dev/CI, dados determinísticos) ou "live".
# Em "live" o boot exige as credenciais OAuth acima.
ADS_INTEGRATIONS_MODE="mock"

# =========================================================================
# Produção / multi-instância (Fase 9)
# =========================================================================
# Chave usada pelo Next para criptografar closures de Server Actions enviadas
# ao client. Se você rodar 2+ containers atrás de um load balancer, TODOS
# precisam compartilhar a mesma chave — caso contrário um instance não
# decifra Server Actions criptografadas por outro ("Failed to find Server
# Action"). Gere com: openssl rand -base64 32
# Em deploy single-container pode deixar vazio (Next gera por build).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# -------------------------------------------------------------------------
# docker-compose (compose.yaml e compose.prod.yaml)
# -------------------------------------------------------------------------
# Usadas pelos serviços `postgres` do compose. Não vão pro container do app
# — o app só consome DATABASE_URL/DIRECT_URL.
POSTGRES_DB="franchise_hub"
POSTGRES_USER="franchise_hub"
POSTGRES_PASSWORD=""

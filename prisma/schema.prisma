// Franchise HUB — schema do banco
// Documentação: https://pris.ly/d/prisma-schema
//
// Princípio multi-tenant: TODAS as tabelas de negócio terão `tenantId`,
// `createdAt`, `updatedAt` e (onde fizer sentido) `deletedAt`. O isolamento é
// reforçado por Row-Level Security do Postgres, ativado por migration manual
// na Fase 3. O Tenant em si é a única tabela "global" — não tem `tenantId`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7+: `url`/`directUrl` saíram do schema. Conexão para o client vem do
// adapter (src/server/db/prisma.ts); conexão para Migrate vem do
// `datasource.url` em prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum UserRole {
  ADMIN       // matriz: vê tudo do tenant
  REGIONAL    // gestor regional: vê franquias de suas regiões
  FRANCHISEE  // franqueado: vê só a própria franquia
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  status       TenantStatus @default(ACTIVE)
  plan         String?
  logoUrl      String?
  primaryColor String?      @default("#7C3AED")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  users User[]

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  emailVerified DateTime?
  name          String?
  // passwordHash é null quando o usuário só usa login social (Fase futura).
  passwordHash  String?
  role          UserRole  @default(FRANCHISEE)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  termsAcceptances TermsAcceptance[]

  // E-mail é único por tenant — o mesmo e-mail pode existir em tenants
  // diferentes (uma franqueadora pode ter o mesmo gerente que outra).
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Registro versionado de aceite de Termos/Política (LGPD).
/// Cada nova versão de documento gera uma nova linha — não atualizamos a
/// antiga, para preservar a trilha de auditoria.
model TermsAcceptance {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  documentKey String // "terms_of_use" | "privacy_policy" | …
  version     String
  acceptedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([documentKey, version])
  @@map("terms_acceptances")
}
